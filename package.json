{
  "name": "inframap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@inframap/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf node_modules dist apps/*/dist packages/*/dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0"
  }
}
